---
import Base from '../../../layouts/Base.astro';
import Bi from '../../../components/Bi.astro';
import { others } from '../../../data/albums';
import { href } from '../../../lib/util';

// 專輯以外的作品；有 ref 者連往歌曲頁
const works: { year: number; title: string; ref?: string; kind: { en: string; zh: string } }[] = [
  { year: 2007, title: 'The Taylor Swift Holiday Collection', kind: { en: 'EP', zh: 'EP' } },
  { year: 2008, title: 'Beautiful Eyes', kind: { en: 'EP', zh: 'EP' } },
  { year: 2009, title: 'Crazier', ref: 'others/crazier', kind: { en: 'Soundtrack · Hannah Montana: The Movie', zh: '電影歌曲．Hannah Montana: The Movie' } },
  { year: 2010, title: 'Today Was a Fairytale', ref: 'fearless/today-was-a-fairytale', kind: { en: "Soundtrack · Valentine's Day", zh: "電影歌曲．Valentine's Day" } },
  { year: 2011, title: 'Safe & Sound', ref: 'others/safe-and-sound', kind: { en: 'Soundtrack · The Hunger Games, with The Civil Wars', zh: '電影歌曲．The Hunger Games，與 The Civil Wars 合作' } },
  { year: 2012, title: 'Ronan', ref: 'red/ronan', kind: { en: 'Charity single', zh: '慈善單曲' } },
  { year: 2012, title: 'Eyes Open', ref: 'others/eyes-open', kind: { en: 'Soundtrack · The Hunger Games', zh: '電影歌曲．The Hunger Games' } },
  { year: 2013, title: 'Sweeter than Fiction', ref: 'others/sweeter-than-fiction', kind: { en: 'Soundtrack · One Chance', zh: '電影歌曲．One Chance' } },
  { year: 2016, title: "I Don't Wanna Live Forever", ref: 'others/i-dont-wanna-live-forever', kind: { en: 'Soundtrack · Fifty Shades Darker, with ZAYN', zh: '電影歌曲．Fifty Shades Darker，與 ZAYN 合作' } },
  { year: 2019, title: 'Christmas Tree Farm', ref: 'others/christmas-tree-farm', kind: { en: 'Holiday single', zh: '聖誕單曲' } },
  { year: 2019, title: 'Beautiful Ghosts', ref: 'others/beautiful-ghosts', kind: { en: 'Soundtrack · Cats', zh: '電影歌曲．Cats' } },
  { year: 2020, title: 'Only the Young', ref: 'others/only-the-young', kind: { en: 'Miss Americana', zh: '紀錄片 Miss Americana' } },
  { year: 2022, title: 'Carolina', ref: 'others/carolina', kind: { en: 'Soundtrack · Where the Crawdads Sing', zh: '電影歌曲．Where the Crawdads Sing' } },
  { year: 2026, title: 'I Knew It, I Knew You', ref: 'others/i-knew-it-i-knew-you', kind: { en: 'Soundtrack · Toy Story 5', zh: '電影歌曲．《反斗奇兵 5》' } },
];
---
<Base title="Other Works · Taylor Swift Eras" theme={others.theme} era="others" page="others">
  <section class="era-hero" style="min-height:70svh">
    <div class="wrap">
      <p class="eyebrow">Bonus Era</p>
      <h1 class="foil" style="font-family:'Great Vibes';font-weight:400">Other Works</h1>
      <p class="tagline"><Bi l={{ en: 'EPs, soundtracks, collaborations and singles that live outside the twelve albums.', zh: '十二張專輯以外的 EP、電影歌曲、合作作品和單曲。' }} /></p>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap">
      <ol class="works">
        {works.map((w, i) => (
          <li data-reveal style={`--d:${(i % 4) * 0.08}s`}>
            {w.ref ? (
              <a class="glass" href={href(`/eras/${w.ref}/`)}>
                <span class="y foil">{w.year}</span>
                <span class="t" style={`view-transition-name:s-${w.ref.split('/')[1]}`}>{w.title} <span class="go">→</span></span>
                <span class="k"><Bi l={w.kind} /></span>
              </a>
            ) : (
              <div class="glass">
                <span class="y foil">{w.year}</span>
                <span class="t">{w.title}</span>
                <span class="k"><Bi l={w.kind} /></span>
              </div>
            )}
          </li>
        ))}
      </ol>
      <p class="section-sub" style="margin-top:2rem"><Bi l={{ en: 'Tap a song for its full story; the two EPs are listed for reference.', zh: '點選歌曲可閱讀完整解讀；兩張 EP 只作列出參考。' }} /></p>
      <p style="text-align:center"><a class="btn ghost" href={href('/#eras')}>← <span class="l-zh">返回所有時期</span><span class="l-en">Back to the eras</span></a></p>
    </div>
  </section>
</Base>

<style is:global>
  .works { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .works li > * { padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; gap: 2px 16px; align-items: baseline; height: 100%; color: inherit; text-decoration: none; transition: transform .5s cubic-bezier(.2,.7,.2,1), border-color .5s; }
  .works li > a:hover { transform: translateY(-3px); border-color: var(--accent); }
  .works .go { color: var(--accent); font-size: .9em; }
  .works .y { font-family: var(--display); font-weight: 700; font-size: 1.3rem; grid-row: span 2; }
  .works .t { font-family: var(--display); font-size: 1.15rem; }
  .works .k { font-size: .85rem; color: var(--muted); }
</style>
