---
import Base from '../../../layouts/Base.astro';
import Bi from '../../../components/Bi.astro';
import Photo from '../../../components/Photo.astro';
import Spotify from '../../../components/Spotify.astro';
import { albums } from '../../../data/albums';
import { songsByAlbum, sectionLabel, sectionOrder } from '../../../data/songs';
import { events } from '../../../data/timeline';
import { interviews } from '../../../data/interviews';
import type { Album } from '../../../data/types';
import { commons, href, fmtDate, bi } from '../../../lib/util';

export function getStaticPaths() {
  return albums.map((a, i) => ({ params: { slug: a.slug }, props: { a, n: i + 1 } }));
}
const { a, n } = Astro.props as { a: Album; n: number };
const songs = songsByAlbum[a.slug] ?? [];
const eraEvents = events.filter((e) => e.album === a.slug).sort((x, y) => x.date.localeCompare(y.date));
const eraInterviews = interviews.filter((i) => i.album === a.slug);
const prev = albums[n - 2];
const next = albums[n];
const rot = (i: number) => `${((i * 37) % 7) - 3}deg`;
const mvCount = songs.filter((s) => s.mv).length;
const spotify = a.tv?.spotifyAlbum || a.spotifyAlbum;
---
<Base title={`${a.title} · Taylor Swift Eras`} theme={a.theme} era={a.slug} page="eras">
  <section class="era-hero">
    <div class="bgimg" aria-hidden="true">{a.photos[0] && <div data-parallax="0.18"><img src={commons(a.photos[0].file, 1280)} alt="" data-soft class="fadein" referrerpolicy="no-referrer" /></div>}</div>
    <div class="wrap">
      <p class="eyebrow" data-reveal>Era {String(n).padStart(2, '0')} · {a.year}</p>
      <h1 class="era-title" style={`view-transition-name:e-${a.slug}`}>{a.title}</h1>
      <p class="tagline" data-split><Bi l={a.tagline} /></p>
      <div class="meta" data-reveal style="--d:.4s">
        <span class="chip"><Bi l={fmtDate(a.date)} /></span>
        {a.tv && <span class="chip">{a.tv.title} · <Bi l={fmtDate(a.tv.date)} /></span>}
        {songs.length > 0 && <a class="chip" href="#tracks">{songs.length} <span class="l-zh">首歌</span><span class="l-en">songs</span></a>}
        {mvCount > 0 && <span class="chip">▶ {mvCount} MV</span>}
      </div>
    </div>
  </section>

  <section style="padding-top:20px">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow" data-reveal><span class="l-zh">關於這個時期</span><span class="l-en">About this era</span></p>
        <div class="prose lede" data-reveal style="margin-top:1rem"><Fragment set:html={bi(a.summary, { tag: 'p', rich: true })} /></div>
      </div>
      <div style="display:grid;gap:20px">
        <ul class="facts" data-reveal="right">{a.facts.map((f) => <li><Bi l={f} /></li>)}</ul>
        {spotify && <div data-reveal="right" style="--d:.15s"><Spotify kind="album" id={spotify} /></div>}
      </div>
    </div>
  </section>

  {a.chapters?.length ? (
    <section style="padding-top:0">
      <div class="wrap chapters">
        {a.chapters.map((c, i) => (
          <article class="chapter">
            <span class="no" data-reveal>Chapter {String(i + 1).padStart(2, '0')}</span>
            <div class="read">
              <h3 data-split><Bi l={c.title} /></h3>
              <div class="prose" data-reveal><Fragment set:html={bi(c.body, { tag: 'p', rich: true })} /></div>
            </div>
          </article>
        ))}
      </div>
    </section>
  ) : null}

  {songs.length > 0 ? (
    <section id="tracks">
      <div class="wrap">
        <div class="section-head-c">
          <p class="eyebrow">Tracklist</p>
          <h2 class="section-title era-title" data-split><span class="l-zh">曲目</span><span class="l-en">The songs</span></h2>
          <p class="section-sub" data-reveal><Bi l={{ en: 'Every song opens into its own page: the era, the story, the lyrics explained part by part, the video, and the threads that tie it to other songs.', zh: '每首歌都有獨立頁面：時期背景、創作故事、歌詞逐段解讀、MV 解析，以及與其他歌曲之間的連線。' }} /></p>
        </div>
        {sectionOrder.map((sec) => {
          const list = songs.filter((s) => s.section === sec);
          if (!list.length) return null;
          return (
            <>
              <div class="section-head"><h3><Bi l={sectionLabel[sec]} /></h3><small>{list.length}</small></div>
              <div class="tracks">
                {list.map((s) => {
                  const ph = s.photos?.[0] ?? a.photos[s.track % a.photos.length];
                  return (
                    <a class="polaroid" href={href(`/eras/${a.slug}/${s.slug}/`)} style={`--r:${rot(s.track)}`} data-reveal>
                      <div class="ph">
                        <img src={commons(ph.file, 500)} alt="" loading="lazy" data-soft referrerpolicy="no-referrer" />
                        <span class="t" style={`view-transition-name:s-${s.slug}`}>{s.title}</span>
                      </div>
                      <div class="cap">
                        <span class="no"><span>No. {s.track}</span>{s.mv && <span class="badge">▶ MV</span>}</span>
                        {s.title}
                      </div>
                    </a>
                  );
                })}
              </div>
            </>
          );
        })}
      </div>
    </section>
  ) : (
    <section>
      <div class="wrap read card coming" data-reveal style="margin:0 auto">
        <p class="eyebrow">Coming soon</p>
        <h2 class="era-title" style="font-size:2rem"><span class="l-zh">歌曲內容籌備中</span><span class="l-en">Songs coming soon</span></h2>
        <p><Bi l={{ en: 'The songs of this era are being written up and will appear here shortly.', zh: '這個時期的歌曲解讀正在撰寫，稍後會在這裏出現。' }} /></p>
      </div>
    </section>
  )}

  {eraEvents.length > 0 && (
    <section>
      <div class="wrap">
        <div class="section-head-c">
          <p class="eyebrow">Moments</p>
          <h2 class="section-title era-title" data-split><span class="l-zh">這個時期的大事</span><span class="l-en">Moments of the era</span></h2>
        </div>
        <ol class="mini-tl read" style="margin-inline:auto">
          {eraEvents.map((e) => (
            <li data-reveal>
              <span class="d"><Bi l={fmtDate(e.date)} /></span>
              <div class="card"><strong><Fragment set:html={bi(e.title, { rich: true })} /></strong>{e.body && <Fragment set:html={bi(e.body, { tag: 'p', rich: true })} />}</div>
            </li>
          ))}
        </ol>
        <p style="text-align:center"><a class="btn ghost" href={href(`/timeline/#y${a.year}`)}><span class="l-zh">在完整時間線查看</span><span class="l-en">See the full timeline</span> →</a></p>
      </div>
    </section>
  )}

  {eraInterviews.length > 0 && (
    <section style="padding-top:0">
      <div class="wrap read" style="margin:0 auto">
        <div class="section-head"><h3><span class="l-zh">相關訪問</span><span class="l-en">Interviews</span></h3></div>
        <div style="display:grid;gap:10px">
          {eraInterviews.map((iv) => (
            <a class="card iv-row" href={href(`/interviews/#${iv.id}`)} data-reveal>
              <span class="chip">{iv.outlet}</span> <strong><Bi l={iv.title} /></strong> <span>{iv.youtube ? '▶' : '↗'}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><h3><span class="l-zh">相冊</span><span class="l-en">Gallery</span></h3><small>Wikimedia Commons</small></div>
      <div class="gallery">{a.photos.map((p) => <Photo p={p} />)}</div>
    </div>
  </section>

  <nav class="wrap pager" aria-label="Eras">
    {prev ? <a class="card" href={href(`/eras/${prev.slug}/`)}><small>← <span class="l-zh">上一個時期</span><span class="l-en">Previous era</span></small>{prev.title}</a> : <span></span>}
    {next ? <a class="card next" href={href(`/eras/${next.slug}/`)}><small><span class="l-zh">下一個時期</span><span class="l-en">Next era</span> →</small>{next.title}</a> : <a class="card next" href={href('/eras/others/')}><small><span class="l-zh">其他作品</span><span class="l-en">Other works</span> →</small>Other Works</a>}
  </nav>
</Base>

<style is:global>
  .coming { padding: clamp(24px, 4vw, 48px); text-align: center; }
  .mini-tl { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: 18px; }
  .mini-tl li { display: grid; grid-template-columns: 1fr; gap: 6px; }
  @media (min-width: 700px) { .mini-tl li { grid-template-columns: 9.5em 1fr; } }
  .mini-tl .d { font-family: var(--display); color: var(--accent); font-size: .88rem; padding-top: 14px; }
  .mini-tl .card { padding: 14px 18px; }
  .mini-tl p { margin: .4em 0 0; color: var(--muted); font-size: .95em; }
  .iv-row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 14px 18px; text-decoration: none; }
  .iv-row strong { flex: 1; }
</style>
